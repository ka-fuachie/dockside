{
  "name": "dockside",
  "version": "0.1.0",
  "description": "",
  "private": "true",
  "scripts": {
    "dev:worker": "pnpm --filter @dockside/worker dev",
    "dev:cli": "pnpm --filter @dockside/cli dev",
    "start:cli": "pnpm --filter @dockside/cli start",
    "dev:web": "pnpm --filter @dockside/web dev",
    "start:api": "cd ./api && ./mvnw spring-boot:run",
    "test:worker": "pnpm --filter @dockside/worker test",
    "test:api-client": "pnpm --filter @dockside/api-client test",
    "test:deployment-config": "pnpm --filter @dockside/deployment-config test",
    "test:api": "cd ./api && ./mvnw test",
    "link:cli": "pnpm --filter @dockside/cli clink",
    "unlink:cli": "pnpm --filter @dockside/cli unclink"
  },
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0",
  "devDependencies": {
    "oxlint": "^1.87.0",
    "patch-package": "^8.0.1",
    "typescript": "^7.0.2"
  }
}
