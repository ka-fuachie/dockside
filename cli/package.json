{
  "name": "@dockside/cli",
  "version": "0.1.0",
  "description": "",
  "type": "module",
  "private": "true",
  "bin": {
    "dockside": "./dist/index.mjs"
  },
  "scripts": {
    "dev": "tsx watch --env-file=../.env --conditions=source src/index.ts",
    "start": "tsx --env-file=../.env --conditions=source src/index.ts",
    "build": "tsdown",
    "clink": "pnpm add -g .",
    "unclink": "pnpm uninstall -g @dockside/cli"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.7",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "@dockside/api-client": "workspace:*",
    "@dockside/deployment-config": "workspace:*",
    "commander": "^15.0.0",
    "fflate": "^0.8.3",
    "read": "^6.0.0",
    "zod": "^4.6.7"
  }
}
